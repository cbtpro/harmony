{
  "name": "harmony",
  "version": "1.0.0",
  "description": "基于electron、vite、vue3的文件管理系统，让混沌的文件变得和谐。",
  "main": "dist-electron/main/index.js",
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/files.test.mts tests/file-browser.test.mts tests/file-index.test.mts tests/terminals.test.mts tests/media.test.mts",
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "npm run build:app && electron-builder --publish never",
    "build:staging": "vue-tsc --noEmit && vite --mode staging build && electron-builder",
    "preview": "vite preview",
    "test:ui": "playwright test",
    "build:app": "vue-tsc --noEmit && vite build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/cbtpro/harmony.git"
  },
  "keywords": [
    "electron",
    "vite",
    "vue3",
    "文件管理",
    "跨平台"
  ],
  "author": {
    "name": "陈碧滔",
    "email": "cbtpro@163.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cbtpro/harmony/issues"
  },
  "homepage": "https://github.com/cbtpro/harmony#readme",
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "electron": "39.8.5",
    "electron-builder": "26.8.1",
    "typescript": "^4.9.5",
    "unplugin-auto-import": "^0.15.0",
    "unplugin-vue-components": "^0.24.0",
    "vite": "^4.1.4",
    "vite-plugin-electron": "^0.11.1",
    "vue-tsc": "^1.2.0"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "dayjs": "^1.11.7",
    "element-plus": "^2.2.32",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "6.5.438",
    "pinia": "^2.0.32",
    "vue": "^3.2.47",
    "vue-router": "^4.1.6"
  }
}
